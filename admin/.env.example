# ── Shared ───────────────────────────────────────────────────────────────
ADMIN_API_URL=http://127.0.0.1:8787
ADMIN_API_TOKEN=replace-with-a-long-random-string   # e.g. `openssl rand -hex 32`

# ── admin_api.py — point these at your actual trading bot's files ─────────
BOT_DB_PATH=/opt/btc-bot/data/trades.db
BOT_LOG_PATH=/opt/btc-bot/logs/bot.log
CONTROL_FILE_PATH=/opt/btc-bot/data/control.json
BALANCE_FILE_PATH=/opt/btc-bot/data/balance.json
BOT_SYSTEMD_UNIT=btc-bot.service
TRADES_TABLE_NAME=trades

# ── telegram_bot.py ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=   # your numeric chat_id(s), comma-separated

# ── discord_bot.py ──────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=from-discord-developer-portal
DISCORD_GUILD_ID=your-server-id
DISCORD_ALLOWED_ROLE_ID=your-admin-role-id       # optional, leave blank to skip
DISCORD_ALLOWED_USER_IDS=your-discord-user-id    # optional, comma-separated
