logs/
logs/*.log
data/pm_trader/
data/paper_ledger_state.json
data/*.db
data/*.json
data/backups/
KILL_SWITCH

# Model artifacts
*.pt
*.pkl
models/*.json
models/*.pt
models/*.pkl
models/*.txt
