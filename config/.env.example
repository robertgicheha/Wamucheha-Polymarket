# Copy this to config/.env and fill in your values. Never commit the real .env.
#
# ACCOUNT SETUP GUIDE — minimum new accounts needed:
#   1. Polymarket        — sign up at polymarket.com with a FRESH wallet that has
#                          never been in any file, repo or chat. Your account
#                          gets a Deposit Wallet; that address is the "funder".
#   2. Signer key        — the private key of that fresh wallet (the SIGNER).
#   3. Alchemy/Infura    — free tier gives you a Polygon RPC URL at dashboard.alchemy.com
#                          or infura.io (select "Polygon Mainnet" network)
#   4. OKX / Binance     — FUNDING SOURCES only: they send USDC (Polygon) to your
#                          Polymarket bridge deposit address. They are never the
#                          funder/trading wallet. See "Funding" below.
#   5. NewsAPI            — newsapi.org free tier (100k req/mo)
#   6. Telegram bot       — message @BotFather on Telegram, /newbot, copy the token,
#                           then send a message to your bot and get chat_id via
#                           https://api.telegram.org/bot<TOKEN>/getUpdates
#   7. Discord webhook    — Server Settings > Integrations > Webhooks > New Webhook
#   8. SMTP email         — use Gmail app-password, or any SMTP-capable email for alerts
#
# Before going live: python scripts/preflight.py   (must print READY)
# For The Graph subgraph: no account, public endpoint.

# === Mode ===
TRADING_MODE=paper                  # paper | live -- ALWAYS start with paper
# Live trading additionally requires this exact phrase (typo-proof arming switch):
LIVE_TRADING_ACK=                   # I understand this trades real money
LOG_LEVEL=INFO

# === Polymarket (CLOB V2 / pUSD — uses the official polymarket-client SDK) ===
POLYMARKET_PRIVATE_KEY=             # signer private key (0x...) — NEVER commit it
# The account wallet that holds pUSD + positions ("funder"): copy it from the
# polymarket.com profile menu. Leave empty to use the signer's Deposit Wallet.
POLYMARKET_FUNDER_ADDRESS=
# Optional: CLOB API creds. Leave empty and they are derived from the key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Relayer API key for gasless approvals/redemptions (polymarket.com → Settings →
# API Keys → Relayer API Keys). Needed for Deposit/Proxy/Safe wallets.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_HOST=https://clob.polymarket.com
# Gamma API (read-only, no auth needed)
GAMMA_API_HOST=https://gamma-api.polymarket.com

# === Polygon / Alchemy / Infura ===
# From dashboard.alchemy.com or infura.io → create project → Polygon Mainnet
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Backups tried in order if the primary fails (comma-separated)
POLYGON_RPC_FALLBACK_URLS=https://polygon.drpc.org
POLYGON_RPC_TIMEOUT_SECONDS=10
# Address to report balances for (usually = POLYMARKET_FUNDER_ADDRESS)
POLYGON_WALLET_ADDRESS=

# === The Graph — Polymarket subgraph ===
# NOTE: Polymarket migrated to new CTF Exchange contracts on 2026-04-28.
# Post-migration subgraph endpoint (check docs.polymarket.com for updates):
GRAPH_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/YOUR_SUBGRAPH_ID
# Pre-migration fallback (for historical data before 2026-04-28):
GRAPH_SUBGRAPH_URL_LEGACY=https://api.thegraph.com/subgraphs/name/polymarket/ctf-exchange
# Migration cutoff date — any trade history spanning this date needs both endpoints
GRAPH_MIGRATION_DATE=2026-04-28

# === Binance (market data is public; key only needed for funding) ===
# For funding: key with "Enable Withdrawals" (Binance requires IP restriction
# for that) and FUNDING_DEPOSIT_ADDRESS on the withdrawal whitelist.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === OKX (market data is public; key only needed for funding) ===
# For funding: key with Read + Withdraw, IP-whitelisted to the bot host,
# FUNDING_DEPOSIT_ADDRESS in the withdrawal address book, USDC in the Funding account.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# === Funding: OKX/Binance → Polymarket ===
# Your Polymarket bridge deposit address for Polygon USDC (polymarket.com →
# Deposit, or `python scripts/preflight.py` shows the expected value). USDC sent
# there is auto-wrapped to pUSD. The bot verifies this address before sending.
FUNDING_DEPOSIT_ADDRESS=
AUTO_FUNDING_ENABLED=false          # top up automatically when pUSD runs low
FUNDING_SOURCE=okx                  # okx | binance
FUNDING_MIN_BALANCE_USD=20          # auto top-up trigger
FUNDING_TOPUP_USD=50                # auto top-up amount
FUNDING_MAX_WITHDRAWAL_USD=100      # hard cap per withdrawal
FUNDING_MAX_DAILY_USD=200           # hard cap per rolling 24h

# === News / data feeds ===
NEWSAPI_KEY=                        # from newsapi.org
GDELT_ENABLED=true

# === Stake & profit management ===
# COMPOUNDING MODE: all profits stay in the account and are reinvested automatically.
# The bot compounds gains by increasing position sizes as bankroll grows.
# You withdraw manually via Telegram /dashboard /withdraw command when you decide to.
INITIAL_STAKE_USD=100                # your principal — protected capital
COMPOUND_ENABLED=true                # master switch: compound profits into stake
REINVEST_PROFITS_ONLY=false          # false = compound the ENTIRE bankroll (principal + profits)
                                     # true = only trade with profit above principal
COMPOUND_GROWTH_TARGET_PCT=0        # optional: bot alerts when profit hits this % (0 = disabled)
                                     # e.g. 50 = alert when you're up 50%
PROFIT_REPORT_INTERVAL_CYCLES=72    # how often to send profit status (72 x 5min = every 6 hours)
WITHDRAWAL_ENABLED=true             # enable manual withdrawal via Telegram commands
WITHDRAWAL_DESTINATION_ADDRESS=     # where to send USDC when you trigger a withdrawal

# === Categories & signal cadence ===
CATEGORIES_ENABLED=crypto                    # crypto only (BTC, ETH, SOL, XRP, Gold)
SIGNAL_CHECK_INTERVAL_SECONDS=300    # 5 minutes — checks this often, trades only above threshold
MIN_EDGE_THRESHOLD=0.05              # minimum divergence from market-implied probability to trade

# === Risk management (hard limits, not model-controlled) ===
STOP_LOSS_PCT=8
CIRCUIT_BREAKER_DAILY_DRAWDOWN_PCT=5
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3
MAX_POSITION_SIZE_PCT=5
MAX_CONCURRENT_POSITIONS=10
MAX_EXPOSURE_PER_CATEGORY_PCT=40

# === ML / AI Settings ===
ML_MODEL_DIR=models                 # directory to store trained models
ML_RETRAIN_INTERVAL_HOURS=168       # retrain every 7 days
ML_ENSEMBLE_WEIGHTS=0.35,0.25,0.20,0.20  # GARCH,LSTM,XGBoost,LightGBM
ML_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
ML_LOOKBACK_DAYS=90                 # historical data window for feature engineering
ML_MIN_SAMPLES_FOR_TRAINING=50      # minimum resolved markets before enabling live trading
ML_KELLY_FRACTION=0.25             # fractional Kelly (conservative)
ML_CONFIDENCE_THRESHOLD=0.3        # minimum model confidence to act on signal
ML_PREDICTION_ENABLED=false        # gate for the real TTE-model prediction path in
                                    # the 5-min lifecycle engine; run
                                    # scripts/bootstrap_tte_models.py and confirm
                                    # Brier scores first, then flip to true

# === Alerts ===
# Telegram: message @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# Get your chat_id: visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Email: use Gmail with app-password, or any SMTP provider
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=                    # your-email@gmail.com
ALERT_EMAIL_TO=                      # where to send critical alerts
ALERT_EMAIL_PASSWORD=               # app-password for Gmail, or SMTP password

# === Kalshi ===
# From kalshi.com → Account → API Keys
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
KALSHI_API_BASE=https://trading-api.kalshi.com/trade-api/v2
KALSHI_WS_BASE=wss://trading-api.kalshi.com/ws/v1

# === PMXT (unified Polymarket + Kalshi API) ===
# From github.com/pmxt-dev/pmxt
PMXT_API_KEY=
PMXT_WALLET_ADDRESS=
PMXT_PRIVATE_KEY=

# === BRTI (Bitcoin Real-Time Index) Engine ===
# Replicates CF Benchmarks BRTI for Kalshi BTC contract settlement
BRTI_EXCHANGES=coinbase,kraken,bitstamp,gemini     # constituent exchanges
BRTI_ORDER_SIZE_CAP=100                             # max order size per level (BTC)
BRTI_MAX_VOLUME=5000                                # max volume for utilized depth calc
BRTI_DEVIATION_THRESHOLD=0.005                      # 0.5% deviation threshold
BRTI_VALIDATION_ENABLED=true                        # validate spread divergence
BRTI_MAX_DIVERGENCE_BPS=5.0          # max |top-of-book spread| across venues (bps); cross-venue books are often crossed ~1 bps
BRTI_TICK_INTERVAL_SECONDS=1                        # tick frequency (1-sec for BRTI)
BRTI_KALSHI_AVG_WINDOW=60                           # Kalshi settlement: 60-sec rolling avg

# === ML BTC Prediction (Layer 1) ===
ML_BTC_TRAIN_PARALLEL=true                          # parallel model training
ML_BTC_MAX_WORKERS=8                                # CPU cores for parallel training
ML_RETRAIN_HOUR=3                                   # daily retrain at 3am UTC
ML_LSTM_EPOCHS=50                                   # LSTM/GRU training epochs
ML_SEQUENCE_LENGTH=60                               # input sequence length (seconds)

# === Price zone filtering (based on empirical calibration research) ===
# Bürgi, Deng & Whelan (2026): cheap contracts (<23¢) are UNDERPRICED, not overpriced
# Default 8-85¢ avoids both tails
MIN_PRICE_THRESHOLD=0.08                            # don't trade below 8¢
MAX_PRICE_THRESHOLD=0.85                            # don't trade above 85¢

# === Synthetic Arbitrage (Polymarket + Kalshi) ===
ARB_MIN_SPREAD_CENTS=5.0                            # min spread between platforms to trade
ARB_MAX_HOLD_MINUTES=30                             # max hold time for arb positions

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USERNAME=                 # set both before exposing the dashboard
DASHBOARD_PASSWORD=                 # beyond localhost / an SSH tunnel

# === Gnosis Safe / Relayer (gasless payments) ===
# Gasless mode: Polymarket relayer pays gas for your trades
# Requires deployment via Relayer Client
GNOSIS_SAFE_ENABLED=false           # enable Gnosis Safe for secure key management
GNOSIS_SAFE_ADDRESS=                # your Safe address (0x...) — deploy via relayer first
GNOSIS_SAFE_OWNER_KEY=              # private key of the Safe owner (the trading bot)
RELAYER_ENABLED=true                # use Polymarket relayer for gasless transactions
RELAYER_GAS_LIMIT=500000            # gas limit per relayer transaction
BATCH_TRANSACTIONS=true             # batch multiple orders into single transactions

# === 5-Minute Market Lifecycle Engine ===
# Inspired by KaustubhPatange/polymarket-trade-engine
# Each market is a lifecycle: DISCOVER -> START -> RUN -> END -> SETTLED
LIFECYCLE_ENGINE_ENABLED=true       # enable the 5-minute market lifecycle engine
MARKET_DISCOVERY_INTERVAL=30        # how often to scan for new 5-min markets (seconds)
ORDERBOOK_UPDATE_INTERVAL=1.0       # how often to process orderbook updates (seconds)
UPDOWN_ASSETS=btc                   # only btc has an index feed (BRTI) today
UPDOWN_INTERVAL_MINUTES=5           # 5 or 15

# Entry/exit rules (fair-value model vs. order book, net of taker fees).
# EARLY_EXIT_TAKE_PROFIT_PCT / EARLY_EXIT_STOP_LOSS_PCT are no longer used:
# exits happen when the bid pays more than the model's value (EXIT_EDGE).
MIN_NET_EDGE=0.03                   # P(win) - (ask + taker fee) required to enter
EXIT_EDGE=0.02                      # sell early if net bid - model value >= this
MAX_SPREAD=0.04                     # skip books wider than this
ENTRY_MIN_ELAPSED_SECONDS=20        # no entries in the first N seconds
ENTRY_MIN_REMAINING_SECONDS=20      # ...or the last N seconds of a window
SETTLEMENT_BASIS_BPS=2.0            # our index vs Chainlink uncertainty
ALLOW_BASELINE_LIVE=false           # allow live trading without the ML model

# Live guard rails
LIVE_MAX_ORDER_USD=10               # hard cap per order
LIVE_MAX_OPEN_EXPOSURE_USD=30       # hard cap on total open cost basis
KILL_SWITCH_FILE=KILL_SWITCH        # `touch KILL_SWITCH` stops new entries instantly
AUTO_REDEEM_ENABLED=true            # redeem resolved winners back to pUSD
ARB_SCAN_ENABLED=false              # cross-platform arb is simulation-only

# === Scheduler (5-min status pings + hourly reports) ===
STATUS_PING_INTERVAL_SECONDS=300    # send compact status ping every 5 minutes
HOURLY_REPORT_INTERVAL_SECONDS=3600 # send full hourly report every hour

# === Database & Trade Logging ===
# Every trade is logged synchronously to SQLite — never loses a fill on crash
TRADE_LOG_DB_PATH=data/trade_log.db  # path to trade log database
BACKUP_INTERVAL_HOURS=6             # database backup frequency (hours)
BACKUP_RETAIN_DAYS=30               # delete backups older than this

# === Docker Backup Sidecar ===
BACKUP_HOST_PATH=/opt/wamucheha-backups  # host path for backup volume
BACKUP_INTERVAL=6                         # backup interval in hours (Docker sidecar)
BACKUP_RETAIN_DAYS=30                     # backup retention in days (Docker sidecar)
