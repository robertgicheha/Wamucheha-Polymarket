# Copy this to config/.env and fill in your values. Never commit the real .env.
#
# ACCOUNT SETUP GUIDE — minimum new accounts needed:
#   1. Polymarket        — sign up at polymarket.com, create API keys in settings
#   2. Dedicated wallet  — generate a fresh Polygon wallet (e.g. MetaMask) for trading
#   3. Alchemy/Infura    — free tier gives you a Polygon RPC URL at dashboard.alchemy.com
#                          or infura.io (select "Polygon Mainnet" network)
#   4. OKX               — register at okx.com, create API keys for funding on-ramp
#   5. NewsAPI            — newsapi.org free tier (100k req/mo)
#   6. Telegram bot       — message @BotFather on Telegram, /newbot, copy the token,
#                           then send a message to your bot and get chat_id via
#                           https://api.telegram.org/bot<TOKEN>/getUpdates
#   7. Discord webhook    — Server Settings > Integrations > Webhooks > New Webhook
#   8. SMTP email         — use Gmail app-password, or any SMTP-capable email for alerts
#
# For Binance (OHLCV + funding rates): just the public API, no account needed.
# For The Graph subgraph: no account, public endpoint.

# === Mode ===
TRADING_MODE=paper                  # paper | live -- ALWAYS start with paper
LOG_LEVEL=INFO

# === Polymarket ===
# From polymarket.com → Settings → API Keys
POLYMARKET_PRIVATE_KEY=             # your Polygon wallet private key (0x...)
POLYMARKET_API_KEY=                 # CLOB API key
POLYMARKET_API_SECRET=              # CLOB API secret
POLYMARKET_API_PASSPHRASE=          # CLOB API passphrase
POLYMARKET_HOST=https://clob.polymarket.com
# Gamma API (read-only, no auth needed)
GAMMA_API_HOST=https://gamma-api.polymarket.com

# === Polygon / Alchemy / Infura ===
# From dashboard.alchemy.com or infura.io → create project → Polygon Mainnet
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Your dedicated trading wallet address (0x...)
POLYGON_WALLET_ADDRESS=

# === The Graph — Polymarket subgraph ===
# NOTE: Polymarket migrated to new CTF Exchange contracts on 2026-04-28.
# Post-migration subgraph endpoint (check docs.polymarket.com for updates):
GRAPH_SUBGRAPH_URL=https://gateway.thegraph.com/api/subgraphs/id/YOUR_SUBGRAPH_ID
# Pre-migration fallback (for historical data before 2026-04-28):
GRAPH_SUBGRAPH_URL_LEGACY=https://api.thegraph.com/subgraphs/name/polymarket/ctf-exchange
# Migration cutoff date — any trade history spanning this date needs both endpoints
GRAPH_MIGRATION_DATE=2026-04-28

# === Binance (OHLCV + funding rates — public, no auth needed) ===
BINANCE_API_KEY=                    # optional, only if you want higher rate limits
BINANCE_API_SECRET=

# === OKX ===
# From okx.com → Settings → API → Create API key
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# === News / data feeds ===
NEWSAPI_KEY=                        # from newsapi.org
GDELT_ENABLED=true

# === Stake & profit management ===
# COMPOUNDING MODE: all profits stay in the account and are reinvested automatically.
# The bot compounds gains by increasing position sizes as bankroll grows.
# You withdraw manually via Telegram /dashboard /withdraw command when you decide to.
INITIAL_STAKE_USD=100                # your principal — protected capital
REINVEST_PROFITS_ONLY=false          # false = compound the ENTIRE bankroll (principal + profits)
                                     # true = only trade with profit above principal
COMPOUND_GROWTH_TARGET_PCT=0        # optional: bot alerts when profit hits this % (0 = disabled)
                                     # e.g. 50 = alert when you're up 50%
PROFIT_REPORT_INTERVAL_CYCLES=72    # how often to send profit status (72 x 5min = every 6 hours)
WITHDRAWAL_ENABLED=true             # enable manual withdrawal via Telegram commands
WITHDRAWAL_DESTINATION_ADDRESS=     # where to send USDC when you trigger a withdrawal

# === Categories & signal cadence ===
CATEGORIES_ENABLED=crypto,politics,sports,macro
SIGNAL_CHECK_INTERVAL_SECONDS=300    # 5 minutes — checks this often, trades only above threshold
MIN_EDGE_THRESHOLD=0.05              # minimum divergence from market-implied probability to trade

# === Risk management (hard limits, not model-controlled) ===
STOP_LOSS_PCT=8
CIRCUIT_BREAKER_DAILY_DRAWDOWN_PCT=5
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3
MAX_POSITION_SIZE_PCT=5
MAX_CONCURRENT_POSITIONS=10
MAX_EXPOSURE_PER_CATEGORY_PCT=40

# === ML / AI Settings ===
ML_MODEL_DIR=models                 # directory to store trained models
ML_RETRAIN_INTERVAL_HOURS=168       # retrain every 7 days
ML_ENSEMBLE_WEIGHTS=0.35,0.25,0.20,0.20  # GARCH,LSTM,XGBoost,LightGBM
ML_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
ML_LOOKBACK_DAYS=90                 # historical data window for feature engineering
ML_MIN_SAMPLES_FOR_TRAINING=50      # minimum resolved markets before enabling live trading
ML_KELLY_FRACTION=0.25             # fractional Kelly (conservative)
ML_CONFIDENCE_THRESHOLD=0.3        # minimum model confidence to act on signal

# === Alerts ===
# Telegram: message @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# Get your chat_id: visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
# Email: use Gmail with app-password, or any SMTP provider
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=                    # your-email@gmail.com
ALERT_EMAIL_TO=                      # where to send critical alerts
ALERT_EMAIL_PASSWORD=               # app-password for Gmail, or SMTP password

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
